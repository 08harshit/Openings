# ---------------------------------------------------------------------------
# Personal Job Portal — environment template
#
# Copy to `apps/api/.env` for local API development.
# On Render, set these as environment variables on the service (see render.yaml).
# NOTHING in this file is a real credential. Fill in when you have the accounts.
# ---------------------------------------------------------------------------

# --- Runtime ---------------------------------------------------------------
NODE_ENV=development
PORT=3000
# Comma-separated list of origins allowed to call the API.
CORS_ORIGINS=http://localhost:4200

# --- Supabase --------------------------------------------------------------
# Project Settings -> API. The URL looks like https://<ref>.supabase.co
SUPABASE_URL=
# "anon / public" key — safe to expose to the browser, used only to verify JWTs.
SUPABASE_ANON_KEY=
# "service_role" key — SERVER ONLY. Bypasses RLS. Never ship this to Angular.
SUPABASE_SERVICE_ROLE_KEY=
# Project Settings -> API -> JWT Settings -> JWT Secret.
# Used to verify the HS256 access tokens Supabase Auth issues.
SUPABASE_JWT_SECRET=

# --- Groq (skill-gap engine) ------------------------------------------------
# console.groq.com/keys
GROQ_API_KEY=
GROQ_BASE_URL=https://api.groq.com
# JSON-mode extraction quality vs. speed tradeoff — swap freely, the code is
# model-agnostic as long as the model supports response_format: json_object.
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_MAX_TOKENS=2048

# --- Firecrawl (scraping engine) -------------------------------------------
# firecrawl.dev -> API Keys
FIRECRAWL_API_KEY=
FIRECRAWL_BASE_URL=https://api.firecrawl.dev
# API version to target: v2 (current) or v1 (legacy). Responses from both are
# handled; this only decides which endpoints get called.
FIRECRAWL_API_VERSION=v2
# Results requested per auto-discovery search query.
FIRECRAWL_SEARCH_LIMIT=10
# Max career-page URLs pulled per pinned company during a map+scrape pass.
FIRECRAWL_MAP_LIMIT=15

# --- Ingestion pipeline ----------------------------------------------------
# Cron expression for the scheduled scrape. Default: 06:00 and 18:00 UTC daily.
INGEST_CRON=0 6,18 * * *
# Set to false to disable the scheduler (e.g. when running a second instance).
INGEST_CRON_ENABLED=true
# Hard ceiling on jobs analysed by Claude per run — the main cost lever.
INGEST_MAX_ANALYSES_PER_RUN=40
# Hard ceiling on new postings inserted per run.
INGEST_MAX_NEW_JOBS_PER_RUN=100
# Hard ceiling on brand-new companies resolved (ATS/homepage lookups) per run —
# each attempt costs Firecrawl calls, so this bounds discovery spend per run.
INGEST_MAX_NEW_COMPANIES_PER_RUN=5
# Concurrent Groq analyses. Groq's free tier rate-limits hard enough that
# concurrency just trades "faster" for "more 429s" — 1 (sequential, with a
# Retry-After-aware backoff) is usually the actually-faster choice. Raise
# only on a paid Groq tier.
INGEST_ANALYSIS_CONCURRENCY=1
# Reject postings older than this. Applied both as a Firecrawl search-time
# filter (tbs custom date range) and as a post-scrape check against any date
# extracted from the listing text. A posting with no extractable date is kept
# (unknown isn't evidence of staleness) — this only rejects provable staleness.
INGEST_MAX_POSTING_AGE_DAYS=2
# Days without a status change before an applied job is flagged stale.
STALE_APPLICATION_DAYS=7

# --- Optional: protect the manual refresh endpoint from cold-start abuse ----
# If set, /ingest/refresh also accepts this value via the x-ingest-token header
# (used by external cron pingers). Leave blank to require a user JWT only.
INGEST_TRIGGER_TOKEN=
