# ---------------------------------------------------------------------------
# Personal Job Portal — API environment
#
# Copy this file to `.env` in this directory (apps/api/.env) for local dev.
# Nest's ConfigModule loads .env relative to the process working directory,
# which is apps/api when you run `npm run start:dev --workspace @jobportal/api`.
#
# On Render, set these as environment variables on the service instead —
# see ../../render.yaml. NOTHING here is a real credential.
# ---------------------------------------------------------------------------

# --- Runtime ---------------------------------------------------------------
NODE_ENV=development
PORT=3000
CORS_ORIGINS=http://localhost:4200

# --- Supabase --------------------------------------------------------------
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_JWT_SECRET=

# --- Groq (skill-gap engine) ------------------------------------------------
GROQ_API_KEY=
GROQ_BASE_URL=https://api.groq.com
GROQ_MODEL=openai/gpt-oss-120b
GROQ_MAX_TOKENS=2048

# --- Firecrawl (scraping engine) -------------------------------------------
FIRECRAWL_API_KEY=
FIRECRAWL_BASE_URL=https://api.firecrawl.dev
FIRECRAWL_API_VERSION=v2
FIRECRAWL_SEARCH_LIMIT=10
FIRECRAWL_MAP_LIMIT=15

# --- Ingestion pipeline ----------------------------------------------------
INGEST_CRON=0 6,18 * * *
INGEST_CRON_ENABLED=true
INGEST_MAX_ANALYSES_PER_RUN=40
INGEST_MAX_NEW_JOBS_PER_RUN=100
INGEST_MAX_NEW_COMPANIES_PER_RUN=5
INGEST_ANALYSIS_CONCURRENCY=1
INGEST_MAX_POSTING_AGE_DAYS=2
STALE_APPLICATION_DAYS=7

# --- Optional: external cron pinger token -----------------------------------
INGEST_TRIGGER_TOKEN=
